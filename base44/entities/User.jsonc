{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "Nom complet fourni par le client lors de son inscription"
    },
    "profile_photo": {
      "type": "string",
      "description": "Photo de profil du client (URI de fichier prive)"
    }
  },
  "required": [
    "role"
  ]
}