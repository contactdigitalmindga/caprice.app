{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "Nom complet fourni par le client lors de son inscription"
    },
    "profile_photo": {
      "type": "string",
      "description": "Photo de profil du client (URI de fichier prive)"
    },
    "push_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Abonnement aux notifications activ\u00e9 par d\u00e9faut, d\u00e9sactivable par le client. La permission syst\u00e8me du t\u00e9l\u00e9phone reste obligatoire."
    }
  },
  "required": [
    "role"
  ]
}